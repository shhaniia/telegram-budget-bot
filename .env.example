# Get this from @BotFather on Telegram after creating your bot
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Your personal Telegram numeric user ID(s), comma-separated.
# This bot handles real financial data, so only these user IDs will be allowed
# to talk to it. Get your ID by messaging @userinfobot on Telegram.
ALLOWED_USER_IDS=123456789

# Path to the SQLite database file. On Railway, point this at a path inside
# your mounted volume (e.g. /data/budget.db) so data survives redeploys.
DATABASE_PATH=./data/budget.db

# IANA timezone used for "today/this week/this month" boundaries and for
# scheduling daily reminder jobs (e.g. Asia/Singapore, America/New_York).
TIMEZONE=Asia/Singapore

# Local time (HH:MM, 24h) each day the bot checks recurring items and
# subscription renewal reminders.
DAILY_CHECK_TIME=09:00
